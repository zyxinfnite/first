@charset "utf-8";

:root { --bg: #101316; --panel: #181d21; --line: #30383d; --text: #edf2ef; =
--muted: #9aa8a2; --accent: #e7b35a; }

* { box-sizing: border-box; }

body { margin: 0px; min-height: 100vh; color: var(--text); background: radi=
al-gradient(circle at 20% 0,#26352e 0,transparent 34rem),var(--bg); font: 1=
5px / 1.45 Georgia, serif; }

main { width: min(1180px, 100% - 32px); margin: auto; padding: 28px 0px 48p=
x; }

header { display: flex; align-items: end; justify-content: space-between; g=
ap: 20px; padding-bottom: 18px; border-bottom: 1px solid var(--line); }

.eyebrow { margin: 0px 0px 8px; color: var(--accent); font: 700 11px ui-mon=
ospace, monospace; letter-spacing: 0.14em; text-transform: uppercase; }

h1 { margin: 0px; font: 400 clamp(2.5rem, 7vw, 5.8rem) / 0.85 Georgia, seri=
f; letter-spacing: -0.05em; }

.status { color: var(--muted); font: 12px ui-monospace, monospace; text-ali=
gn: right; }

.dot { display: inline-block; width: 8px; height: 8px; margin-right: 7px; b=
order-radius: 50%; background: var(--accent); }

.workspace { display: grid; grid-template-columns: minmax(0px, 1fr) 280px; =
gap: 16px; margin-top: 18px; }

.stage { display: grid; place-items: center; min-height: 520px; padding: 20=
px; border: 1px solid var(--line); background: rgb(8, 10, 11); box-shadow: =
rgba(0, 0, 0, 0.533) 0px 20px 60px; }

#player { width: 100%; height: 100%; min-height: 480px; display: grid; plac=
e-items: center; }

#player ruffle-player { width: 100%; height: 100%; min-height: 480px; }

.empty { max-width: 430px; padding: 35px; border: 1px dashed rgb(89, 100, 9=
5); color: var(--muted); text-align: center; }

.empty strong { display: block; margin-bottom: 8px; color: var(--text); fon=
t-size: 1.35rem; font-weight: 400; }

.sidebar { display: flex; flex-direction: column; gap: 16px; }

section { padding: 18px; border: 1px solid var(--line); background: rgba(24=
, 29, 33, 0.867); }

h2 { margin: 0px 0px 12px; font-size: 1.1rem; font-weight: 400; }

p { margin: 0px; color: var(--muted); }

input[type=3D"file"] { width: 100%; color: var(--muted); font: 12px ui-mono=
space, monospace; }

button { width: 100%; margin-top: 9px; padding: 10px 12px; border: 1px soli=
d var(--line); color: var(--text); background: rgb(36, 44, 45); font: 700 1=
2px ui-monospace, monospace; cursor: pointer; }

button:hover { border-color: var(--accent); color: var(--accent); }

button.primary { color: rgb(23, 19, 11); background: var(--accent); border-=
color: var(--accent); }

.drop { margin-top: 12px; padding: 18px 10px; border: 1px dashed rgb(89, 10=
0, 95); color: var(--muted); text-align: center; font-size: 13px; }

.drop.active { border-color: var(--accent); color: var(--accent); }

code { color: var(--accent); font-family: ui-monospace, monospace; }

footer { padding-top: 14px; color: var(--muted); font: 11px ui-monospace, m=
